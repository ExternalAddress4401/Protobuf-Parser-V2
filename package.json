{
  "name": "@externaladdress4401/beatstar-protobuf",
  "version": "1.0.0",
  "description": "A protobuf parser made for Beatstar",
  "author": "ExternalAddress4401",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./responses": {
      "import": "./dist/responses/*.js",
      "require": "./dist/responses/index.js",
      "types": "./dist/responses/*.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "test": "npx jest",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "publish": "npm pack && npm publish"
  },
  "keywords": [],
  "directories": {
    "test": "tests"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.2",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "undici-types": "^7.10.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ExternalAddress4401/Protobuf-Parser-V2.git"
  }
}
